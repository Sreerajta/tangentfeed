{
  "name": "@tangentfeed/react",
  "version": "0.2.0",
  "description": "React hooks for tangentfeed",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "tsup src/index.ts --format esm --dts --clean --external react"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@tangentfeed/core": "0.2.0",
    "@tangentfeed/schema": "0.2.0",
    "tangentfeed": "0.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sreerajta/tangentfeed.git",
    "directory": "packages/react"
  },
  "engines": {
    "node": ">=20"
  }
}
